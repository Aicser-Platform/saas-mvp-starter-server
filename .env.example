# DATABASE CONNECTION
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mvp_saas

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mvp_saas
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Supabase Auth JWT Secret (Project Settings → API → JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Internal secret for Stripe webhook → FastAPI calls (must match the frontend .env)
INTERNAL_API_SECRET=change-me-internal-secret

# CORS / URLs
FRONTEND_URL=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
# Signature verification currently runs in the Next.js webhook route, so this
# value is not load-bearing in the backend today, but keep it set for parity.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Azure Storage
STORAGE_BACKEND=azure
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=uploads

# Bakong KHQR
BAKONG_TOKEN=
BAKONG_ACCOUNT=your_account@bank
